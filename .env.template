# ==============================================================================
# 共通環境変数テンプレート
# ==============================================================================
# 全章で使用する環境変数をまとめたテンプレートです。
# 使い方:
#   1. ルートで .env を作成してAPIキーを設定（初回のみ）
#      cp .env.template .env
#   2. 作業する章のディレクトリにコピー
#      cp .env chX/.env

# ==============================================================================
# 全章共通（ch3〜ch9）
# ==============================================================================

# Azure OpenAI 設定
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# その他APIキー
EXA_API_KEY=

# LLMモデル設定（Azure OpenAI のデプロイ名）
LLM_MODEL=gpt-5

# 埋め込みモデル（Azure OpenAI のデプロイ名）
EMBEDDING_MODEL=text-embedding-3-small

# ツール設定
ENABLE_WEB_SEARCH=true
ENABLE_DOC_SEARCH=true

# ==============================================================================
# 第4章以降（ch4〜ch8）: MLflow Tracking Server
# ==============================================================================

MLFLOW_TRACKING_URI=http://localhost:5000

# ==============================================================================
# 後半の章でのみ使用（必要に応じてコメントを外してください）
# ==============================================================================

# サービング設定（ch7）
# SERVING_PORT=5005

# Milvus接続先（ch8: doc_search用、省略時はローカルファイル）
# MILVUS_URI=http://localhost:19530

# OpenTelemetry（ch8: 05_otel_export.pyで使用）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
